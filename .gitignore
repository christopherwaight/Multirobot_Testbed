# Claude Code instruction files (subdirectory ones are agent artifacts, not source)
**/CLAUDE.md
**/CLAUDE.md.backup
!/CLAUDE.md

# OS files
.DS_Store
Thumbs.db

# Jupyter checkpoints
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
trunk/Python Simulations/Vector_Fields/VF_Robot/venv/

# Machine Learning models (regenerate from training scripts)
*.pth
*.pkl
!vortex_predictors/vortex_rbf_interpolator.pkl
!saddle_predictors/*.pkl
!sinking_vortex_predictors/*.pkl

# MATLAB temporary files and build cache
*.asv
*.mat
*.fig
slprj/

# LaTeX compilation outputs
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg

# Compiled PDFs (regenerate with pdflatex)
Paper_Writing/**/*.pdf
!Paper_Writing/**/figures/*.pdf

# Simulation outputs (regenerate from scripts)
# Exclude from tracking but keep paper figures
*.png
*.jpg
!Paper_Writing/**/figures/*.png
!Paper_Writing/**/figures/*.jpg

# Backup and archive directories
*_backup_*/
* copy */
cluster_builder_before_refactor/
cb2/

# clusterbuilder CLI-generated output files (not source, regenerate with clusterbuilder.py)
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*.yaml
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*_cluster.py
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*_forward_kinematics.py
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*_inverse_kinematics.py
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*_inverse_jacobian.py
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*_forward_jacobian.py
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*_inverse_jacobian_symbolic.txt
trunk/Python Simulations/Vector_Fields/VF_Robot/cluster_builder/*_inverse_jacobian_symbolic.tex

# Logs
*.log
output.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local folders that should never be pushed
trunk/Python Simulations backup 2026-05-01_IGNORE/
trunk/Python Simulations_backup_20251203_172207_IGNORE/
Manim_Viz/

# Paper writing: exclude environments, caches, and LaTeX build junk,
# but keep sources (.tex, .sty, figures, scripts) committable.
# PDFs and non-figure images are already excluded by the rules above.
Paper_Writing/venv/
Paper_Writing/mcp_paper_search/__pycache__/
Paper_Writing/Archives/.venv/
Paper_Writing/vector_store/
Paper_Writing/**/*.synctex.gz
Paper_Writing/**/*.fdb_latexmk
Paper_Writing/**/*.fls
Paper_Writing/**/*.out
Paper_Writing/**/missfont.log

# Claude Code local state (per-user, machine-specific)
.claude/

# Agent-generated planning docs (belong in PR descriptions, not source)
docs/plans/

# Regeneratable experiment result folders
trunk/Python Simulations/Vector_Fields/VF_Robot/experiments/sim2real_results/
trunk/Python Simulations/Vector_Fields/VF_Robot/experiments/sim2real_center_tracking_results/
trunk/Python Simulations/Vector_Fields/VF_Robot/experiments/sim2real_multimode_results/
